# Environment Variables for HomeMatch AI

# Google Gemini API Key (for Vision and LLM features)
# Get your key at: https://makersuite.google.com/app/apikey
# The app works without this key using mock data for demo purposes
NEXT_PUBLIC_GEMINI_API_KEY=

# Optional: Custom API endpoints for property data
NEXT_PUBLIC_PROPERTY_API_URL=

# Analytics (optional)
NEXT_PUBLIC_GA_ID=
